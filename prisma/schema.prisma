generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  STAFF
  RECEPTIONIST
  DOCTOR
  MANAGER
}

enum Status {
  ACTIVE
  INACTIVE
}


enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  passwordHash String
  name String?
  clinics Clinic[]
  clinicMember ClinicMember[]
  doctor Doctor?
  createdDoctors Doctor[] @relation("doctorCreatedBy")
}

model Clinic {
  id Int @id @default(autoincrement())
  name String
  location String
  ownerId Int
  owner User @relation(fields: [ownerId], references: [id])
  clinicMembers ClinicMember[]
  doctorClinic DoctorClinic[]
  @@unique([ownerId, name, location])
}

model ClinicMember {
  id Int @id @default(autoincrement())
  role Role
  clinicId Int
  clinic Clinic @relation(fields: [clinicId], references: [id])
  userId Int
  user User @relation(fields: [userId], references: [id])
  @@unique([clinicId, userId])
}

model Doctor {
  id Int @id @default(autoincrement())
  userId Int @unique
  user User @relation(fields: [userId], references: [id])
  firstName String
  middleName String?
  lastName String?
  qualification String?
  additionalQualification String?
  specialization String?
  experience String?
  createdById Int
  registrationNo String
  createdBy User @relation("doctorCreatedBy", fields: [createdById], references: [id])
  doctorClinics DoctorClinic[]
}

model DoctorClinic {
  id Int @id @default(autoincrement())
  fees Int
  doctorId Int
  doctor Doctor @relation(fields: [doctorId], references: [id])
  clinicId Int
  clinics Clinic @relation(fields: [clinicId], references: [id])
  doctorSchedule DoctorSchedule[]

  @@unique([doctorId, clinicId])
}


model DoctorSchedule {
  id Int @id @default(autoincrement())
  doctorClinicId Int //id of clinic doctor's id
  doctorClinic DoctorClinic @relation(fields: [doctorClinicId], references: [id], onDelete: Cascade)
  dayOfWeek Weekday
  startTime Int // minute since midnight, eg 600 for 10.00 AM
  endTime Int 
}
